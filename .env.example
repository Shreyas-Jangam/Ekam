# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Production Authentication & Database Environment Variables
# JWT_SECRET: Secure secret key for signing production JWT tokens (min 32 random characters)
JWT_SECRET="ekam_production_jwt_secret_key_change_me_2026"

# DATABASE_URL: PostgreSQL connection string for authoritative user records and transactions
# e.g., postgresql://user:password@host:5432/ekam_db
DATABASE_URL="postgresql://postgres:password@localhost:5432/ekam_production"

# SMS OTP Gateway (for Indian Mobile Number Authentication - e.g., MSG91, Twilio, Fast2SMS)
SMS_GATEWAY_API_KEY="MY_SMS_GATEWAY_API_KEY"
SMS_SENDER_ID="EKAMIN"

# Google OAuth Client ID (for One-Tap Google Sign-In)
VITE_GOOGLE_CLIENT_ID="MY_GOOGLE_CLIENT_ID.apps.googleusercontent.com"
